---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Paola Momentè | Portfolio',
	description = 'Portfolio essenziale della pittrice Paola Momentè.',
} = Astro.props;
---

<!doctype html>
<html lang="it">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/photo/logo.png" />
		<link rel="apple-touch-icon" href="/photo/logo.png" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="site-header__inner">
				<a class="site-header__brand" href="/">
					<img src="/photo/logo.png" alt="" aria-hidden="true" />
					<span>Paola Momentè</span>
				</a>
				<nav class="site-header__nav" aria-label="Sezioni del sito">
					<a href="/#quadri">Portfolio</a>
					<a href="/#artista">Artista</a>
					<a href="/#contatti">Contatti</a>
				</nav>
			</div>
		</header>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	:root {
		--site-header-height: 72px;
		color: #231f1b;
		background: #f7f3ed;
		font-family:
			Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		font-size: 16px;
		line-height: 1.5;
	}

	html {
		scroll-padding-top: calc(var(--site-header-height) + 16px);
	}

	* {
		box-sizing: border-box;
	}

	body {
		min-width: 320px;
		padding-top: var(--site-header-height);
		background:
			linear-gradient(180deg, rgba(247, 243, 237, 0.98), rgba(239, 234, 226, 0.96)),
			#f7f3ed;
	}

	.site-header {
		position: fixed;
		z-index: 20;
		top: 12px;
		right: 0;
		left: 0;
		padding: 0 20px;
		pointer-events: none;
	}

	.site-header__inner {
		display: flex;
		width: min(1180px, calc(100% - 40px));
		min-height: var(--site-header-height);
		margin: 0 auto;
		padding: 0 18px;
		gap: 24px;
		align-items: center;
		justify-content: space-between;
		border: 1px solid rgba(35, 31, 27, 0.12);
		border-radius: 8px;
		background: rgba(255, 252, 247, 0.88);
		box-shadow: 0 18px 42px rgba(35, 31, 27, 0.1);
		backdrop-filter: blur(16px);
		pointer-events: auto;
	}

	.site-header__brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: #231f1b;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.35rem;
		font-weight: 400;
		line-height: 1;
		text-decoration: none;
		white-space: nowrap;
	}

	.site-header__brand img {
		width: 34px;
		height: 34px;
		flex: 0 0 auto;
		border-radius: 50%;
		object-fit: cover;
	}

	.site-header__nav {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		align-items: center;
		justify-content: flex-end;
	}

	.site-header__nav a {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		padding: 8px 12px;
		border-radius: 6px;
		color: #3a322b;
		font-size: 0.84rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
		text-transform: uppercase;
		transition:
			background 180ms ease,
			color 180ms ease;
	}

	.site-header__nav a::after {
		position: absolute;
		right: 12px;
		bottom: 6px;
		left: 12px;
		height: 2px;
		border-radius: 999px;
		background: #7b4f35;
		content: "";
		opacity: 0;
		transform: scaleX(0.5);
		transition:
			opacity 180ms ease,
			transform 180ms ease;
	}

	.site-header__brand:hover,
	.site-header__brand:focus-visible,
	.site-header__nav a:hover,
	.site-header__nav a:focus-visible {
		color: #7b4f35;
	}

	.site-header__nav a:hover,
	.site-header__nav a:focus-visible {
		background: rgba(123, 79, 53, 0.08);
	}

	.site-header__nav a:hover::after,
	.site-header__nav a:focus-visible::after {
		opacity: 1;
		transform: scaleX(1);
	}

	img {
		display: block;
		max-width: 100%;
	}

	a {
		color: inherit;
	}

	[id] {
		scroll-margin-top: calc(var(--site-header-height) + 16px);
	}

	@media (max-width: 640px) {
		:root {
			--site-header-height: 96px;
		}

		.site-header__inner {
			width: 100%;
			flex-direction: column;
			gap: 10px;
			align-items: flex-start;
			justify-content: center;
			padding: 14px;
		}

		.site-header__brand {
			font-size: 1.18rem;
		}

		.site-header__nav {
			justify-content: flex-start;
		}

		.site-header__nav a {
			font-size: 0.78rem;
		}
	}
</style>
