---
import Layout from '../layouts/Layout.astro';
import { portfolioSections } from '../data/portfolio';
---

<Layout
	title="Paola Momentè | Pittrice"
	description="Portfolio ordinato, elegante e minimal della pittrice Paola Momentè."
>
	<header class="hero" aria-label="Introduzione">
		<img src="/photo/paola_hero.jpg" alt="Quadro astratto di Paola Momentè" fetchpriority="high" />
		<div class="hero__overlay" aria-hidden="true"></div>
		<div class="hero__content">
			<p>pittrice</p>
			<h1>Paola Momentè</h1>
		</div>
	</header>

	<main>
		<section class="section portfolio" id="quadri" aria-labelledby="portfolio-title">
			<div class="section__header">
				<p>quadri</p>
				<h2 id="portfolio-title">Portfolio</h2>
			</div>

			<div class="portfolio__grid">
				{
					portfolioSections.map((section) => (
						<a class="portfolio-card" href={`/portfolio/${section.slug}/`}>
							<img src={section.image} alt={`Opera della sezione ${section.title}`} loading="lazy" />
							<div class="portfolio-card__body">
								<h3>{section.title}</h3>
								<p>{section.summary}</p>
								<span>Apri sezione</span>
							</div>
						</a>
					))
				}
			</div>
		</section>

		<section class="section about" id="artista" aria-labelledby="about-title">
			<img src="/photo/paola.jpg" alt="Paola Momentè in galleria" loading="lazy" />
			<div class="about__content">
				<p class="eyebrow">chi è l'artista</p>
				<h2 id="about-title">Paola Momentè</h2>
				<p>
					Paola Momentè lavora su tele essenziali, dove materia, luce e segno convivono in equilibrio.
					La sua ricerca pittorica attraversa memoria, paesaggio interiore e silenzio visivo.
				</p>
				<address class="contacts" id="contatti">
					<a href="mailto:paolamomente22@gmail.com">paolamomente22@gmail.com</a>
					<a href="tel:+393491289750">349 1289750</a>
					<a href="https://www.facebook.com/momentep/" target="_blank" rel="noreferrer">Facebook</a>
					<a href="https://www.instagram.com/veronese.momente/" target="_blank" rel="noreferrer">
						Instagram
					</a>
				</address>
			</div>
		</section>
	</main>
</Layout>

<style>
	:global(body) {
		padding-top: 0;
	}

	.hero {
		position: relative;
		display: grid;
		min-height: 100svh;
		overflow: hidden;
		place-items: center;
	}

	.hero img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero__overlay {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(180deg, rgba(18, 17, 15, 0.12), rgba(18, 17, 15, 0.28)),
			radial-gradient(circle at center, rgba(247, 243, 237, 0.06), rgba(18, 17, 15, 0.2));
	}

	.hero__content {
		position: relative;
		z-index: 1;
		width: min(92vw, 1100px);
		padding: 24px 20px;
		color: #fffaf2;
		text-align: center;
		text-shadow: 0 18px 45px rgba(0, 0, 0, 0.28);
	}

	.hero__content p,
	.section__header p,
	.eyebrow {
		margin: 0 0 14px;
		color: #7f6b5d;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.hero__content p {
		color: rgba(255, 250, 242, 0.82);
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		margin-bottom: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(3.25rem, 11vw, 9.5rem);
		font-weight: 400;
		line-height: 0.95;
		letter-spacing: 0;
	}

	h2 {
		margin-bottom: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2.2rem, 5vw, 4.6rem);
		font-weight: 400;
		line-height: 1;
		letter-spacing: 0;
	}

	h3 {
		margin-bottom: 12px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.55rem;
		font-weight: 400;
		line-height: 1.12;
	}

	.section {
		width: min(1180px, calc(100% - 40px));
		margin: 0 auto;
		padding: 64px 0;
	}

	.section__header {
		margin-bottom: 24px;
	}

	.portfolio__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 18px;
	}

	.portfolio-card {
		display: grid;
		grid-template-rows: auto 1fr;
		min-height: 100%;
		overflow: hidden;
		border: 1px solid rgba(35, 31, 27, 0.12);
		border-radius: 8px;
		background: rgba(255, 252, 247, 0.72);
		text-decoration: none;
		transition:
			border-color 180ms ease,
			transform 180ms ease,
			background 180ms ease;
	}

	.portfolio-card:hover,
	.portfolio-card:focus-visible {
		border-color: rgba(126, 83, 57, 0.45);
		background: #fffaf4;
		transform: translateY(-3px);
	}

	.portfolio-card img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.portfolio-card__body {
		display: flex;
		min-height: 190px;
		flex-direction: column;
		padding: 20px;
	}

	.portfolio-card__body p {
		margin-bottom: 18px;
		color: #62584f;
	}

	.portfolio-card__body span {
		margin-top: auto;
		color: #7b4f35;
		font-size: 0.86rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.about {
		display: grid;
		grid-template-columns: minmax(280px, 0.85fr) minmax(300px, 1fr);
		gap: clamp(28px, 5vw, 64px);
		align-items: center;
		padding-top: 22px;
	}

	.about > img {
		width: 100%;
		max-height: 680px;
		aspect-ratio: 4 / 5;
		border-radius: 8px;
		object-fit: cover;
	}

	.about__content > p:not(.eyebrow) {
		max-width: 620px;
		margin: 20px 0 26px;
		color: #514940;
		font-size: 1.08rem;
	}

	.contacts {
		display: flex;
		flex-wrap: wrap;
		gap: 12px 22px;
		font-style: normal;
	}

	.contacts a {
		border-bottom: 1px solid rgba(123, 79, 53, 0.36);
		color: #3a322b;
		text-decoration: none;
	}

	.contacts a:hover,
	.contacts a:focus-visible {
		border-color: #7b4f35;
		color: #7b4f35;
	}

	@media (max-width: 860px) {
		.section {
			width: min(100% - 28px, 680px);
			padding: 48px 0;
		}

		.portfolio__grid,
		.about {
			grid-template-columns: 1fr;
		}

		.portfolio-card__body {
			min-height: 160px;
		}
	}
</style>
